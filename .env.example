# Copy to .env. Never commit the populated file.
VIBE_UI_PASSWORD=replace-with-a-long-local-password
VIBE_RESEARCH_PROVIDER=vibe_trading.research.competition:create_backend
VIBE_RESEARCH_ROOT=research
VIBE_RESEARCH_RUNS_ROOT=.local/research-runs

# ninef read-only account, quote, order-history, ranking and news access.
NINEF_API_TOKEN=
NINEF_ACCOUNT_KEY=
NINEF_COMPETITION_ID=
NINEF_MARKET_PROFILE=
NINEF_VERIFICATION_REF=

# Tushare. Leave BASE_URL empty for the official service.
TUSHARE_TOKEN=
TUSHARE_BASE_URL=
TUSHARE_TOKEN_FILE=

# Direct, non-agent S5 review through an OpenAI-compatible endpoint.
RESEARCH_LLM_PROVIDER=openai_compatible
RESEARCH_LLM_MODEL=
RESEARCH_LLM_BASE_URL=
RESEARCH_LLM_API_KEY=
RESEARCH_LLM_REASONING_EFFORT=configured
RESEARCH_LLM_TIMEOUT_SECONDS=120

# Intentionally absent: VIBE_ENABLE_NINEF_WRITES and *_VERIFIED switches.
